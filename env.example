# Copy this file to .env and fill in your real key. .env itself is gitignored
# and will never be committed -- only this template (env.example) is tracked.
#
# Get a key at https://platform.claude.com -> Settings -> API keys -> Create key.
# Requires a payment method on the account; there is no permanent free tier,
# though new accounts get a small starter credit.

ANTHROPIC_API_KEY=sk-ant-api03-...

# Only needed if you run the open-weight backend (--backend openai) against a
# local vLLM server. vLLM ignores the value but the OpenAI client requires the
# env var to be set to something.
OPENAI_API_KEY=EMPTY
